<div class="auth-page" data-feedback-exclude>
  <header class="auth-header">
    <a class="wordmark" href={~p"/"} aria-label="Fluently home">
      <img src={~p"/images/fluently.svg"} width="40" height="40" alt="" />
      <span>Fluently</span>
    </a>
    <a class="auth-back" href={~p"/"}>Back to the demo <span aria-hidden="true">↗</span></a>
  </header>

  <main class="auth-layout" id="account-main">
    <aside class="auth-story" aria-label="Feedback in context">
      <div>
        <p class="auth-eyebrow">
          <span class="status-dot" aria-hidden="true"></span> A LITTLE CONTEXT GOES A LONG WAY
        </p>
        <h2>Good feedback<br />has <span>a place.</span></h2>
        <p class="auth-story-copy">
          On the actual element. On the actual page.<br />Right where the conversation belongs.
        </p>
      </div>
      <div class="auth-example" aria-label="Illustrative feedback example">
        <div class="auth-example-bar">
          <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>your-website.com</span>
        </div>
        <div class="auth-example-content">
          <p class="auth-example-label">THE START OF SOMETHING GOOD</p>
          <div class="auth-example-target">
            <span>A clearer starting point.</span>
            <span class="auth-example-pin" aria-hidden="true">1</span>
          </div>
          <div class="auth-example-lines" aria-hidden="true"><span></span><span></span></div>
          <div class="auth-example-comment">
            <div class="auth-example-author">
              <span class="auth-avatar" aria-hidden="true">Y</span><strong>You</strong><span>Just now</span><span class="auth-example-status">Open</span>
            </div>
            <p>Could we make this headline more specific?</p>
            <div class="auth-example-context">
              <span aria-hidden="true">↳</span> Headline · feedback in context
            </div>
          </div>
        </div>
      </div>
      <p class="auth-story-footer">A comment. An anchor. The context to act.</p>
    </aside>

    <section class="auth-form-section" aria-labelledby="account-heading">
      <p class="auth-eyebrow">
        {if @mode == :signup, do: "LET’S GET STARTED", else: "YOUR NEXT CONVERSATION"}
      </p>
      <h1 id="account-heading">
        {if @mode == :signup, do: "Create your account.", else: "Welcome back."}
      </h1>
      <p class="auth-intro">
        {if @mode == :signup,
          do: "Bring Fluently to your own website.",
          else: "Sign in to your workspace and pick up where you left off."}
      </p>
      <div :if={@error} class="auth-error" role="alert" id="account-error">{@error}</div>
      <.form
        for={@form}
        action={if @mode == :signup, do: ~p"/signup", else: ~p"/login"}
        id="account-form"
        class="auth-form"
        aria-describedby={if @error, do: "account-error"}
      >
        <.input
          :if={@mode == :signup}
          field={@form[:name]}
          label="Your name"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="Alex Morgan"
          class="auth-input"
        />
        <.input
          field={@form[:email]}
          type="email"
          label="Email address"
          required
          maxlength="160"
          autocomplete="email"
          placeholder="you@company.com"
          class="auth-input"
        />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          required
          minlength={if @mode == :signup, do: "15"}
          maxlength="128"
          autocomplete={if @mode == :signup, do: "new-password", else: "current-password"}
          class="auth-input"
          aria-describedby={if @mode == :signup, do: "password-hint"}
        />
        <p :if={@mode == :signup} class="auth-help" id="password-hint">
          At least 15 characters. A memorable phrase works well.
        </p>
        <button type="submit" class="button button-primary auth-submit" id="account-submit"><span>{if @mode ==
                                                                                                        :signup,
                                                                                                      do:
                                                                                                        "Create account",
                                                                                                      else:
                                                                                                        "Sign in"}</span><span aria-hidden="true">↗</span></button>
      </.form>
      <p :if={@mode == :signup} class="auth-switch">
        Already have an account? <a href={~p"/login"}>Log in</a>
      </p>
      <p :if={@mode == :login} class="auth-switch">
        New to Fluently? <a href={~p"/signup"}>Create an account</a>
      </p>
      <div class="auth-form-note">
        <span class="auth-note-mark" aria-hidden="true">↳</span>
        <p :if={@mode == :signup}>
          Guest feedback stays with its project. Creating an account does not claim or link your guest reviews.
        </p>
        <p :if={@mode == :login}>
          Signing in opens your account’s saved feedback. Feedback from a separate guest session won’t be transferred.
        </p>
      </div>
    </section>
  </main>
  <footer class="auth-footer">For the people who see it. And the agents who fix it.</footer>
</div>
